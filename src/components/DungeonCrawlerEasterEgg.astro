---
// A tiny, easy-to-miss dungeon-crawler easter egg.
// Click the trigger to reveal a small grid-based multi-room dungeon:
// 3 connected rooms, HP-based combat, a key + locked door, and a boss fight.
---

<div class="dce-root" data-dce-root>
  <button type="button" class="dce-trigger" data-dce-trigger aria-expanded="false" aria-controls="dce-game">
    ▸ psst...
  </button>

  <div class="dce-game" id="dce-game" data-dce-game hidden>
    <div class="dce-header">
      <p class="dce-hint">
        Arrow keys / WASD to move.
        <span class="dce-legend-t">$</span> loot,
        <span class="dce-legend-m">M</span> monster,
        <span class="dce-legend-d">D</span>/<span class="dce-legend-l">L</span> doors (L needs a key),
        <span class="dce-legend-b">B</span> boss.
      </p>
      <button type="button" class="dce-close" data-dce-close aria-label="Close game">✕</button>
    </div>
    <div class="dce-stats">
      <span class="dce-hp" data-dce-hp>HP: ♥♥♥♥♥</span>
      <span class="dce-inventory" data-dce-inventory>Carrying: nothing (yet).</span>
    </div>
    <div class="dce-grid" data-dce-grid role="img" aria-label="Dungeon room"></div>
    <p class="dce-message" data-dce-message aria-live="polite">You slip into a forgotten room...</p>
    <div class="dce-choices" data-dce-choices hidden>
      <button type="button" class="dce-btn" data-dce-fight>Fight</button>
      <button type="button" class="dce-btn" data-dce-flee>Flee</button>
    </div>
  </div>
</div>

<style>
  .dce-root {
    margin-top: 2rem;
    font-family: var(--font-mono);
  }

  .dce-trigger {
    background: none;
    border: none;
    padding: 0.15rem 0.3rem;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    opacity: 0.55;
    cursor: pointer;
    letter-spacing: 0.02em;
    transition: opacity 0.15s ease, color 0.15s ease;
  }

  .dce-trigger:hover,
  .dce-trigger:focus-visible {
    opacity: 1;
    color: var(--accent);
  }

  .dce-game {
    margin-top: 0.75rem;
    border: 1px solid var(--border);
    background: var(--bg-elevated);
    border-radius: 8px;
    padding: 0.9rem;
    max-width: 22rem;
  }

  .dce-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.6rem;
  }

  .dce-hint {
    margin: 0;
    font-size: 0.7rem;
    color: var(--text-muted);
    line-height: 1.4;
  }

  .dce-legend-t {
    color: var(--accent-strong);
  }

  .dce-legend-m {
    color: #e08a8a;
  }

  .dce-legend-d,
  .dce-legend-l {
    color: var(--accent);
  }

  .dce-legend-l {
    font-weight: 700;
  }

  .dce-legend-b {
    color: #e08a8a;
    font-weight: 700;
  }

  .dce-close {
    background: none;
    border: 1px solid var(--border);
    color: var(--text-muted);
    border-radius: 4px;
    width: 1.4rem;
    height: 1.4rem;
    line-height: 1;
    cursor: pointer;
    flex: none;
  }

  .dce-close:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .dce-stats {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.4rem 0.75rem;
    margin-bottom: 0.5rem;
    font-size: 0.7rem;
    color: var(--text-muted);
  }

  .dce-hp {
    color: #e08a8a;
    letter-spacing: 0.05em;
    flex: none;
  }

  .dce-inventory {
    text-align: right;
  }

  .dce-grid {
    display: grid;
    grid-template-columns: repeat(8, 1.75rem);
    grid-template-rows: repeat(8, 1.75rem);
    gap: 2px;
    outline: none;
  }

  /* :global() below is required: these tiles are created dynamically via
     document.createElement in the script, so they never receive Astro's
     scoped data-astro-cid attribute and would otherwise never match. */
  :global(.dce-tile) {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg);
    border: 1px solid rgba(128, 128, 128, 0.4);
    font-size: 0.9rem;
    color: var(--text-muted);
    border-radius: 2px;
  }

  :global(.dce-tile.dce-wall) {
    background: rgba(128, 128, 128, 0.35);
  }

  :global(.dce-tile.dce-player) {
    color: var(--accent);
    font-weight: 700;
  }

  :global(.dce-tile.dce-monster) {
    color: #e08a8a;
  }

  :global(.dce-tile.dce-boss) {
    color: #e08a8a;
    font-weight: 700;
  }

  :global(.dce-tile.dce-treasure) {
    color: var(--accent-strong);
  }

  :global(.dce-tile.dce-key) {
    color: var(--accent-strong);
    font-weight: 700;
  }

  :global(.dce-tile.dce-door) {
    color: var(--accent);
  }

  :global(.dce-tile.dce-locked) {
    color: var(--accent);
    font-weight: 700;
  }

  .dce-message {
    margin: 0.6rem 0 0;
    font-size: 0.78rem;
    color: var(--text);
    min-height: 1.2em;
  }

  .dce-choices {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }

  .dce-choices[hidden] {
    display: none;
  }

  .dce-btn {
    background: var(--bg);
    border: 1px solid var(--border);
    color: var(--text);
    padding: 0.25rem 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    border-radius: 4px;
    cursor: pointer;
  }

  .dce-btn:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .dce-btn:disabled {
    opacity: 0.5;
    cursor: default;
  }
</style>

<script>
  const SIZE = 8;
  const MAX_HP = 8;
  const PLAYER_DMG_MIN = 2;
  const PLAYER_DMG_MAX = 4;

  const LOOT_FLAVOR = [
    'a shiny bottle cap',
    'three suspicious mushrooms',
    'a tiny rubber duck',
    'a slightly bent spoon',
  ];

  // Tile legend: W wall, . floor, M monster, $ treasure (key or loot,
  // see TREASURES), D plain door, L locked door (needs the key), B boss.

  const ROOMS = [
    {
      id: 'entrance',
      entry: { x: 1, y: 1 },
      enterMessage: 'You slip into a forgotten room...',
      rows: [
        'W W W W W W W W',
        'W . . . . . $ W',
        'W . W W . W . W',
        'W . W . . W . W',
        'W . . . W . . W',
        'W W . W W . W W',
        'W . . . M . D W',
        'W W W W W W W W',
      ].map((row) => row.split(' ')),
    },
    {
      id: 'hall',
      entry: { x: 1, y: 1 },
      enterMessage: 'You step into a musty hall. Something bigger scurries up ahead.',
      rows: [
        'W W W W W W W W',
        'W . . . . . D W',
        'W . W W . W . W',
        'W . W . $ W . W',
        'W . . . W . . W',
        'W W . W W . W W',
        'W . . . M . L W',
        'W W W W W W W W',
      ].map((row) => row.split(' ')),
    },
    {
      id: 'boss',
      entry: { x: 1, y: 1 },
      enterMessage: 'A low growl echoes off the stones. This must be the lair.',
      rows: [
        'W W W W W W W W',
        'W . . . . . D W',
        'W . W W . W . W',
        'W . W . . W . W',
        'W . . . W . . W',
        'W W . W W . W W',
        'W . . . B . . W',
        'W W W W W W W W',
      ].map((row) => row.split(' ')),
    },
  ];

  // Doors: "<roomId>:<x>,<y>" -> destination room id.
  // Whether a door is locked is read straight off the tile char ('L' vs 'D').
  const DOORS = {
    'entrance:6,6': 'hall',
    'hall:6,1': 'entrance',
    'hall:6,6': 'boss',
    'boss:6,1': 'hall',
  };

  const MONSTERS = {
    'entrance:4,6': { name: 'dungeon rat', hp: 4, dmgMin: 1, dmgMax: 2 },
    'hall:4,6': { name: 'sewer brute', hp: 6, dmgMin: 2, dmgMax: 3 },
    'boss:4,6': { name: 'Gnawing Sovereign', hp: 9, dmgMin: 1, dmgMax: 3, boss: true },
  };

  const TREASURES = {
    'entrance:6,1': { type: 'key', label: 'a rusty key' },
    'hall:4,3': { type: 'loot' },
  };

  function randInt(min, max) {
    return Math.floor(Math.random() * (max - min + 1)) + min;
  }

  function cellKey(x, y) {
    return `${x},${y}`;
  }

  function initDungeonCrawler(root) {
    const trigger = root.querySelector('[data-dce-trigger]');
    const game = root.querySelector('[data-dce-game]');
    const closeBtn = root.querySelector('[data-dce-close]');
    const gridEl = root.querySelector('[data-dce-grid]');
    const messageEl = root.querySelector('[data-dce-message]');
    const choicesEl = root.querySelector('[data-dce-choices]');
    const fightBtn = root.querySelector('[data-dce-fight]');
    const fleeBtn = root.querySelector('[data-dce-flee]');
    const hpEl = root.querySelector('[data-dce-hp]');
    const inventoryEl = root.querySelector('[data-dce-inventory]');

    if (
      !trigger || !game || !closeBtn || !gridEl || !messageEl || !choicesEl ||
      !fightBtn || !fleeBtn || !hpEl || !inventoryEl
    ) {
      return () => {};
    }

    let currentRoomId = ROOMS[0].id;
    /** @type {{x:number,y:number}} */
    let player = { ...ROOMS[0].entry };
    let hp = MAX_HP;
    /** @type {Array<{id:string,label:string}>} */
    let inventory = [];
    /** @type {Map<string, Set<string>>} */
    let clearedByRoom = new Map();
    let encounterActive = false;
    let gameWon = false;
    /** @type {any} */
    let currentMonster = null;
    let currentEncounterTileKey = null;
    let currentEncounterRoomId = null;
    let combatTimeoutId = null;
    let keydownHandler = null;

    function currentRoomInfo() {
      return ROOMS.find((r) => r.id === currentRoomId);
    }

    function tileAt(room, x, y) {
      return room.rows[y]?.[x];
    }

    function clearedSetFor(roomId) {
      if (!clearedByRoom.has(roomId)) clearedByRoom.set(roomId, new Set());
      return clearedByRoom.get(roomId);
    }

    function hasKey() {
      return inventory.some((item) => item.id === 'key');
    }

    function clearCombatTimeout() {
      if (combatTimeoutId) {
        clearTimeout(combatTimeoutId);
        combatTimeoutId = null;
      }
    }

    function setMessage(text) {
      messageEl.textContent = text;
    }

    function updateHpDisplay() {
      const filled = '♥'.repeat(Math.max(hp, 0));
      const empty = '♡'.repeat(Math.max(MAX_HP - hp, 0));
      hpEl.textContent = `HP: ${filled}${empty}`;
    }

    function updateInventoryDisplay() {
      inventoryEl.textContent = inventory.length
        ? `Carrying: ${inventory.map((item) => item.label).join(', ')}.`
        : 'Carrying: nothing (yet).';
    }

    function render() {
      const room = currentRoomInfo();
      const cleared = clearedSetFor(room.id);
      gridEl.innerHTML = '';
      for (let y = 0; y < SIZE; y++) {
        for (let x = 0; x < SIZE; x++) {
          const cell = document.createElement('div');
          cell.className = 'dce-tile';
          const raw = tileAt(room, x, y);
          const isPlayer = player.x === x && player.y === y;
          const tileKey = cellKey(x, y);
          const wasCleared = cleared.has(tileKey);
          const monsterDef = MONSTERS[`${room.id}:${tileKey}`];
          const treasureDef = TREASURES[`${room.id}:${tileKey}`];

          if (isPlayer) {
            cell.classList.add('dce-player');
            cell.textContent = '@';
          } else if (raw === 'W') {
            cell.classList.add('dce-wall');
          } else if (monsterDef && !wasCleared) {
            cell.classList.add(monsterDef.boss ? 'dce-boss' : 'dce-monster');
            cell.textContent = monsterDef.boss ? 'B' : 'M';
          } else if (treasureDef && !wasCleared) {
            cell.classList.add(treasureDef.type === 'key' ? 'dce-key' : 'dce-treasure');
            cell.textContent = treasureDef.type === 'key' ? 'K' : '$';
          } else if (raw === 'D') {
            cell.classList.add('dce-door');
            cell.textContent = 'D';
          } else if (raw === 'L') {
            cell.classList.add('dce-locked');
            cell.textContent = 'L';
          } else {
            cell.textContent = '';
          }
          gridEl.appendChild(cell);
        }
      }
    }

    function goToRoom(id) {
      const target = ROOMS.find((r) => r.id === id);
      if (!target) return;
      currentRoomId = id;
      player = { ...target.entry };
      encounterActive = false;
      currentMonster = null;
      choicesEl.hidden = true;
      render();
      setMessage(target.enterMessage);
    }

    function collectTreasure(def, tileKey, roomId) {
      clearedSetFor(roomId).add(tileKey);
      if (def.type === 'key') {
        inventory.push({ id: 'key', label: 'a rusty key' });
        setMessage('You pick up a rusty key. This seems important.');
      } else {
        const loot = LOOT_FLAVOR[Math.floor(Math.random() * LOOT_FLAVOR.length)];
        inventory.push({ id: `loot-${roomId}-${tileKey}`, label: loot });
        setMessage(`You found ${loot}! Riches beyond measure (sort of).`);
      }
      updateInventoryDisplay();
      render();
    }

    function startEncounter(monsterDef, tileKey, roomId) {
      encounterActive = true;
      currentMonster = { ...monsterDef };
      currentEncounterTileKey = tileKey;
      currentEncounterRoomId = roomId;
      choicesEl.hidden = false;
      fightBtn.disabled = false;
      fleeBtn.disabled = false;
      if (monsterDef.boss) {
        setMessage(
          `You stand before the ${monsterDef.name} itself, and it does not look pleased. (${monsterDef.hp} HP) Fight, or flee like a sensible adventurer?`
        );
      } else {
        setMessage(`A ${monsterDef.name} blocks your path! (${monsterDef.hp} HP) Fight or flee?`);
      }
    }

    function onMonsterDefeated() {
      clearedSetFor(currentEncounterRoomId).add(currentEncounterTileKey);
      encounterActive = false;
      const wasBoss = !!currentMonster.boss;
      const name = currentMonster.name;
      currentMonster = null;
      render();
      if (wasBoss) {
        winGame(name);
      } else {
        setMessage(`You defeat the ${name}! It scurries off, defeated and a little embarrassed.`);
      }
    }

    function winGame(bossName) {
      gameWon = true;
      choicesEl.hidden = true;
      setMessage(
        `🏆 The ${bossName} crumples into a heap of crumbs and drama. You win! (Close and reopen the game to play again.)`
      );
    }

    function onPlayerFainted() {
      encounterActive = false;
      choicesEl.hidden = true;
      currentMonster = null;
      hp = MAX_HP;
      updateHpDisplay();
      const room = currentRoomInfo();
      player = { ...room.entry };
      setMessage('You faint dramatically (mostly from embarrassment). You wake up at the start of the room, HP fully restored.');
      render();
    }

    function combatRound() {
      if (!encounterActive || !currentMonster) return;
      const dmg = randInt(PLAYER_DMG_MIN, PLAYER_DMG_MAX);
      currentMonster.hp = Math.max(0, currentMonster.hp - dmg);
      setMessage(`You hit the ${currentMonster.name} for ${dmg} (${currentMonster.hp} HP left)!`);

      if (currentMonster.hp <= 0) {
        combatTimeoutId = setTimeout(onMonsterDefeated, 600);
        return;
      }

      combatTimeoutId = setTimeout(() => {
        if (!encounterActive || !currentMonster) return;
        const mdmg = randInt(currentMonster.dmgMin, currentMonster.dmgMax);
        hp = Math.max(0, hp - mdmg);
        updateHpDisplay();
        setMessage(`The ${currentMonster.name} hits back for ${mdmg} (you: ${hp}/${MAX_HP} HP)!`);

        if (hp <= 0) {
          combatTimeoutId = setTimeout(onPlayerFainted, 700);
          return;
        }
        combatTimeoutId = setTimeout(combatRound, 800);
      }, 800);
    }

    function handleFight() {
      if (!encounterActive || !currentMonster) return;
      choicesEl.hidden = true;
      combatRound();
    }

    function handleFlee() {
      if (!encounterActive) return;
      encounterActive = false;
      choicesEl.hidden = true;
      const name = currentMonster ? currentMonster.name : 'creature';
      currentMonster = null;
      setMessage(`You back away from the ${name}, heart pounding. It lets you go... this time.`);
      render();
    }

    function tryMove(dx, dy) {
      if (encounterActive || gameWon) return;
      const room = currentRoomInfo();
      const nx = player.x + dx;
      const ny = player.y + dy;
      if (nx < 0 || ny < 0 || nx >= SIZE || ny >= SIZE) return;
      const raw = tileAt(room, nx, ny);
      if (!raw || raw === 'W') return;
      if (raw === 'L' && !hasKey()) {
        setMessage("The door is locked tight. Perhaps a key is hiding somewhere nearby...");
        return;
      }

      player = { x: nx, y: ny };
      render();

      if (raw === 'D' || raw === 'L') {
        const target = DOORS[`${room.id}:${cellKey(nx, ny)}`];
        if (target) {
          goToRoom(target);
          return;
        }
      }

      const tileKey = cellKey(nx, ny);
      const wasCleared = clearedSetFor(room.id).has(tileKey);
      const monsterDef = MONSTERS[`${room.id}:${tileKey}`];
      const treasureDef = TREASURES[`${room.id}:${tileKey}`];

      if (monsterDef && !wasCleared) {
        startEncounter(monsterDef, tileKey, room.id);
      } else if (treasureDef && !wasCleared) {
        collectTreasure(treasureDef, tileKey, room.id);
      } else {
        setMessage('You tiptoe through the dust.');
      }
    }

    function onKeydown(e) {
      const map = {
        ArrowUp: [0, -1],
        ArrowDown: [0, 1],
        ArrowLeft: [-1, 0],
        ArrowRight: [1, 0],
        w: [0, -1],
        s: [0, 1],
        a: [-1, 0],
        d: [1, 0],
        W: [0, -1],
        S: [0, 1],
        A: [-1, 0],
        D: [1, 0],
      };
      const move = map[e.key];
      if (!move) return;
      e.preventDefault();
      tryMove(move[0], move[1]);
    }

    function openGame() {
      currentRoomId = ROOMS[0].id;
      player = { ...ROOMS[0].entry };
      hp = MAX_HP;
      inventory = [];
      clearedByRoom = new Map();
      encounterActive = false;
      gameWon = false;
      currentMonster = null;
      clearCombatTimeout();
      choicesEl.hidden = true;
      game.hidden = false;
      trigger.setAttribute('aria-expanded', 'true');
      updateHpDisplay();
      updateInventoryDisplay();
      setMessage(ROOMS[0].enterMessage);
      render();

      keydownHandler = onKeydown;
      window.addEventListener('keydown', keydownHandler);
      gridEl.setAttribute('tabindex', '-1');
      gridEl.focus();
    }

    function closeGame() {
      clearCombatTimeout();
      game.hidden = true;
      trigger.setAttribute('aria-expanded', 'false');
      if (keydownHandler) {
        window.removeEventListener('keydown', keydownHandler);
        keydownHandler = null;
      }
    }

    function onTriggerClick() {
      if (game.hidden) {
        openGame();
      } else {
        closeGame();
      }
    }

    trigger.addEventListener('click', onTriggerClick);
    closeBtn.addEventListener('click', closeGame);
    fightBtn.addEventListener('click', handleFight);
    fleeBtn.addEventListener('click', handleFlee);

    // Return a cleanup function for view-transition navigations.
    return () => {
      closeGame();
      trigger.removeEventListener('click', onTriggerClick);
      closeBtn.removeEventListener('click', closeGame);
      fightBtn.removeEventListener('click', handleFight);
      fleeBtn.removeEventListener('click', handleFlee);
    };
  }

  let cleanupFns = [];

  function setup() {
    document.querySelectorAll('[data-dce-root]').forEach((root) => {
      const cleanup = initDungeonCrawler(root);
      cleanupFns.push(cleanup);
    });
  }

  function teardown() {
    cleanupFns.forEach((fn) => fn());
    cleanupFns = [];
  }

  document.addEventListener('astro:page-load', setup);
  document.addEventListener('astro:before-swap', teardown);
</script>
