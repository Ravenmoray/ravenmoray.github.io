---
import { ClientRouter } from 'astro:transitions';
import CanvasBackground from '../components/CanvasBackground.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Karl Murray's personal site — projects and writing." } = Astro.props;
const currentPath = Astro.url.pathname;

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/about/', label: 'About' },
  { href: '/projects/', label: 'Projects' },
  { href: '/blog/', label: 'Blog' },
  { href: '/play/', label: 'Play' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <title>{title}</title>
    {/* Blocking theme-init, duplicated from ThemeToggle.astro so it runs
        pre-paint regardless of where the <ThemeToggle /> button sits in
        the body. Safe to run twice — it's idempotent. */}
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          var theme = stored === 'light' || stored === 'dark' ? stored : 'dark';
          document.documentElement.dataset.theme = theme;
        } catch (e) {
          document.documentElement.dataset.theme = 'dark';
        }
      })();
    </script>
    <ClientRouter />
  </head>
  <body>
    <CanvasBackground />
    <header class="site-header">
      <div class="wrap">
        <a class="site-title" href="/">Karl Murray</a>
        <nav class="site-nav">
          {navLinks.map((link) => (
            <a
              href={link.href}
              class={currentPath === link.href ? 'active' : ''}
              aria-current={currentPath === link.href ? 'page' : undefined}
            >
              {link.label}
            </a>
          ))}
          <ThemeToggle />
        </nav>
      </div>
    </header>
    <main class="wrap">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <p>&copy; {new Date().getFullYear()} Karl Murray.</p>
      </div>
    </footer>
  </body>
</html>
